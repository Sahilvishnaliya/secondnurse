      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Sans",
        "fontSize": {
          "value": 0.88,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.16,
          "unit": "px"
        }
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.32,
          "unit": "px"
        }
      }
    }
