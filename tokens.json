  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 4.4,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "section": {
